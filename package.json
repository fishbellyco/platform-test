{
  "name": "fishbelly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @fishbelly/web dev",
    "build": "pnpm --filter @fishbelly/web build",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test packages/core/test/*.test.ts packages/pipeline/test/*.test.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/pipeline"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
