# Copy to apps/web/.env.local. With nothing set, everything runs on mocks.

# Where the local JSON store and generated files go (default: apps/web/.data)
# FISHBELLY_DATA_DIR=

# Prompt interpreter: "mock" (default) or "claude"
FISHBELLY_INTERPRETER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Python measuring service. Unset = built-in STL measurer (no wall thickness).
# GEOMETRY_SERVICE_URL=http://localhost:8000

# Not wired yet
# MESHY_API_KEY=
